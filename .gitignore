# ============================================================
# .gitignore — Swing & Positional Trading Bot
# ============================================================

# Secrets — NEVER commit these
.env
*.key
*.pem
credentials.json

# Data files (contain your positions and basket — may be sensitive)
data/basket.json
data/signals.json
data/positions.json
data/instrument_master.json
data/*.csv
data/*.xlsx

# Logs
logs/*.log
logs/*.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Misc
*.bak
*.tmp
*.log

# Runtime data files (generated by scripts, not source)
data/*.json
data/price_cache/
logs/*.log

# Runtime data files (generated by scripts, not source)
data/*.json
data/price_cache/
logs/*.log
