# ============================================================
# Environment Variables — copy to .env and fill in your values
# ============================================================

# Dhan API credentials (from web.dhan.co → Profile → Access DhanHQ APIs)
DHAN_CLIENT_ID=10000xxxxx
DHAN_API_KEY=your_api_key_here
DHAN_API_SECRET=your_api_secret_here
DHAN_TOTP_SECRET=your_totp_base32_secret
DHAN_REDIRECT_URL=http://127.0.0.1:5000/dhan/callback

# Swing / Positional Trading Configuration
TRADING_MODE=PAPER
MAX_POSITIONS=8
CAPITAL_PER_POSITION=25000

# FnO Configuration
FNO_PROFIT_LIMIT=15000
FNO_LOSS_LIMIT=8000

# Telegram alerts (optional — create bot via @BotFather)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Paths (relative to project root)
# Override only if you move files
CONFIG_PATH=config/settings.yaml
DATA_DIR=data
LOG_DIR=logs
